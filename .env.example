# ==========================================
# CoachDesk — Environment Configuration
# ==========================================
# There is deliberately NO AI key in this list: CoachDesk never sends client
# record content to any AI service (privacy model hard rule).

# 1. Persistent Database Connection (REQUIRED in production)
# PostgreSQL connection string (e.g. Neon). Production fails fast on startup
# if this is missing. Local development only falls back to data/store.json.
DATABASE_URL=

# 2. Whop Developer Platform Credentials
# From the Whop Developer Dashboard (whop.com/dashboard/developer).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_APP_ID=
WHOP_COMPANY_ID=

# 3. Public Application URL (e.g. https://coachdesk.onrender.com)
APP_URL=

# 4. Server Runtime Configuration
NODE_ENV=development
PORT=3000
