{
  "name": "coachdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CoachDesk \u2014 the client record for Whop coaches. Intake, goals, session notes, check-ins and history per client, created automatically from Whop memberships. No AI processing of client records.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx tests/coachdesk.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@whop/sdk": "^2.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}